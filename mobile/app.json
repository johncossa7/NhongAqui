{
  "expo": {
    "name": "NhongAqui",
    "slug": "nhongaqui",
    "scheme": "nhongaqui",
    "version": "0.1.0",
    "icon": "./assets/branding/NhongAqui_Icon.png",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "mz.co.nhongaqui.app"
    },
    "android": {
      "package": "mz.co.nhongaqui.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/branding/NhongAqui_Icon.png",
        "backgroundColor": "#ffffff"
      }
    },
    "plugins": ["expo-router", "expo-secure-store", "expo-image-picker"]
  }
}
