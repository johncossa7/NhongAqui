{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://nhongaqui-production.up.railway.app/api/v1",
        "EXPO_PUBLIC_WEB_URL": "https://web-production-d7b9f.up.railway.app"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://nhongaqui-production.up.railway.app/api/v1",
        "EXPO_PUBLIC_WEB_URL": "https://web-production-d7b9f.up.railway.app"
      }
    },
    "production": {
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://nhongaqui-production.up.railway.app/api/v1",
        "EXPO_PUBLIC_WEB_URL": "https://web-production-d7b9f.up.railway.app"
      }
    }
  }
}
