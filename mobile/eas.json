{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.nhongaqui.com/api/v1",
        "EXPO_PUBLIC_WEB_URL": "https://nhongaqui.com"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.nhongaqui.com/api/v1",
        "EXPO_PUBLIC_WEB_URL": "https://nhongaqui.com"
      }
    },
    "production": {
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.nhongaqui.com/api/v1",
        "EXPO_PUBLIC_WEB_URL": "https://nhongaqui.com"
      }
    }
  }
}
